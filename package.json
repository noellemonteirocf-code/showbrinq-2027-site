{
  "name": "showbrinq-prototype",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "build": "tsc --noEmit && vite build && esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-server/index.mjs",
    "check": "tsc --noEmit",
    "dev:static": "vite --host 0.0.0.0 --port 3000",
    "start": "NODE_ENV=production node dist-server/index.mjs",
    "db:migrate": "tsx scripts/migrate-cms.ts",
    "test:cms": "tsx --test server/tests/*.test.ts"
  },
  "dependencies": {
    "@tiptap/extension-link": "2.11.5",
    "@tiptap/extension-placeholder": "2.11.5",
    "@tiptap/react": "2.11.5",
    "@tiptap/starter-kit": "2.11.5",
    "cookie-parser": "1.4.7",
    "express": "4.21.2",
    "file-type": "19.6.0",
    "jose": "5.9.6",
    "lucide-react": "0.468.0",
    "mysql2": "3.14.3",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "sanitize-html": "2.17.0",
    "wouter": "3.7.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.8",
    "@types/express": "4.17.21",
    "@types/node": "22.13.10",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "@types/sanitize-html": "2.16.0",
    "@vitejs/plugin-react": "4.7.0",
    "esbuild": "0.25.12",
    "tsx": "4.19.3",
    "typescript": "5.9.3",
    "vite": "6.4.1"
  }
}
